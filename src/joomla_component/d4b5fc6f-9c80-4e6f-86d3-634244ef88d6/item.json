    "php_helper_both": "  [CUSTOMCODE=loggingSetUp]\r\n\r\nstatic function getTransactions($params,$fromDate,$toDate)\r\n{\r\n   $queryParams = [\r\n      'security_key'     => $params['securitykey'],\r\n      'report_type'      => 'transaction', \/\/ Pulls standard transaction details\r\n      'date_search'      => 'created',     \/\/ Options: 'created' or 'updated'\r\n      'start_date'       => $fromDate,\/\/'20260701;000000', \/\/ YYYYMMDDhhmmss format\r\n      'end_date'         => $toDate, \/\/'20260809235959',   \r\n      \/\/'result_limit'     => 1,           \/\/ Optional: Limits rows per page\r\n      \/\/ Only approved transactions\r\n      \/\/ 'condition'    => 'status=Approved',\r\n\r\n    ];\r\n\r\n    \/\/ Initialize cURL session\r\n    $ch = curl_init();\r\n\r\n    \/\/ Set cURL options\r\n    curl_setopt($ch, CURLOPT_URL, $params['apiurl']);\r\n    curl_setopt($ch, CURLOPT_POST, true);\r\n    \/\/ Format payload as a standard URL-encoded query string\r\n    curl_setopt($ch, CURLOPT_POSTFIELDS, http_build_query($queryParams)); \r\n    curl_setopt($ch, CURLOPT_RETURNTRANSFER, true);\r\n    curl_setopt($ch, CURLOPT_SSL_VERIFYPEER, true); \/\/ Keep security enabled for production\r\n\r\n    \/\/ Execute request and fetch response\r\n    $response = curl_exec($ch);\r\n\r\n    \/\/ Error tracking for connection failures\r\n    if (curl_errno($ch)) {\r\n      die('cURL Error: ' . curl_error($ch));\r\n\r\n    }\r\n\r\n    curl_close($ch);\r\nreturn  $response ;\r\n}",
